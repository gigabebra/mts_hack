{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["images", "dataRoot"],
  "properties": {
    "dataRoot": {"type": "string", "pattern": "^/[^\\s]+[^/\\s]$"},
    "images": {
      "type": "object",
      "required": ["loki", "fluentd"],
      "additionalProperties": false,
      "properties": {
        "loki": {"type": "string", "minLength": 1},
        "fluentd": {"type": "string", "minLength": 1}
      }
    }
  }
}
