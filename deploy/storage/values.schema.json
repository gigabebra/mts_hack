{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["nodeName", "dataRoot"],
  "additionalProperties": false,
  "properties": {
    "nodeName": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"},
    "dataRoot": {"type": "string", "pattern": "^/[a-zA-Z0-9_-]+(/[a-zA-Z0-9_-]+)*$"}
  }
}
